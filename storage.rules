rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User uploads - max 10MB per image
    match /users/{userId}/uploads/{imageId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Processed images - read-only for users, written by Cloud Functions
    match /users/{userId}/processed/{imageId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only Cloud Functions can write (via admin SDK)
    }
    
    // Profile images
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
