rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Fields only Cloud Functions may set. The quota system reads
    // subscriptionTier, so letting users write it would unlock premium.
    function serverOnlyUserFields() {
      return ['subscriptionTier', 'subscriptionPlatform', 'subscriptionUpdatedAt',
              'itemsCount', 'lastItemAddedAt'];
    }

    // Users collection
    match /users/{userId} {
      // Users can read and edit their own document, except server-only fields
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(serverOnlyUserFields());
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(serverOnlyUserFields());
      
      // Usage subcollection (monthly usage tracking)
      match /usage/{monthId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Only Cloud Functions can write
      }
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null 
                      && request.auth.uid == userId
                      && request.resource.data.keys().hasOnly(['read']);
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow create: if false; // Only Cloud Functions can create
      }
      
      // Items subcollection (wardrobe items)
      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Public data (e.g., tier pricing)
    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }
    
    // System collection (spending, analytics) - admin only
    match /system/{document=**} {
      allow read, write: if false;
    }
    
    // Analytics collection - admin only
    match /analytics/{document=**} {
      allow read, write: if false;
    }
  }
}
